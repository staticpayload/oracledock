{
  "name": "oracledock",
  "displayName": "Oracle Dock",
  "description": "Sidebar terminal with dynamic CLI command input",
  "version": "1.0.0",
  "publisher": "oracledock",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:oracledock.sidebarView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "oracledock-sidebar",
          "title": "Oracle Dock",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "oracledock-sidebar": [
        {
          "type": "webview",
          "id": "oracledock.sidebarView",
          "name": "Oracle Dock"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "postinstall": "node scripts/fix-node-pty-perms.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
